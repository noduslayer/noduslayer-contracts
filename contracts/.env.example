# Deploy.s.sol
MULTISIG=0x0000000000000000000000000000000000000000   # proposer, canceller and executor on the timelock
TREASURY=0x0000000000000000000000000000000000000000   # fee recipient
TIMELOCK_MIN_DELAY=172800                              # 2 days
ZAP_FEE_BPS=20
CONFIG=robinhood-mainnet

# Every governance script: TimelockAccept.s.sol, CreateBasket.s.sol, Govern.s.sol
TIMELOCK=0x0000000000000000000000000000000000000000
MODE=schedule            # schedule | execute | cancel | status
LABEL=                   # names the operation and seeds its salt; new for every operation
OP=                      # operation id, for execute / cancel / status

# TimelockAccept.s.sol
REGISTRY=0x0000000000000000000000000000000000000000
FACTORY=0x0000000000000000000000000000000000000000
ZAP=0x0000000000000000000000000000000000000000

# CreateBasket.s.sol
BASKETS=tech,ai          # spec names under config/baskets/, at most CHUNK per operation
CHUNK=10

# Govern.s.sol
TARGETS=                 # comma-separated addresses
CALLDATAS=               # comma-separated, from `cast calldata`

# Tests
FORK_TESTS=false
